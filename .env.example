# Browser-safe Supabase project configuration.
# Copy to .env.local for local development after creating/connecting a development project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never place service-role keys, database passwords, access tokens,
# or other privileged secrets in NEXT_PUBLIC_* variables or commit them to Git.

# Server-only, single-use setup secret for claiming the first Library Administrator.
# Generate a strong random value for local/deployment setup. Never commit a real value.
STAFF_BOOTSTRAP_SECRET=
